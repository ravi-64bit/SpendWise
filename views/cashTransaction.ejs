<%- include ('partials/head') %>
    <form action="/payCash" method="POST" class="card">
        <label for="amount" class="field-label">Enter amount</label>
        <input id="amount" type="number" name="amount" class="field-input">

        <label for="description" class="field-label">Enter description</label>
        <input id="description" type="text" name="description" class="field-input">

        <label for="account" class="field-label">Select Account</label>
        <select id="account" name="account" class="field-select">
            <option value="0">General</option>
            <option value="1">Personal</option>
        </select>

        <label for="note" class="field-label">Enter Note</label>
        <input type="text" id="note" name="note" class="field-input">

        <button type="submit" class="btn">Submit</button>
    </form>
<%- include ('partials/foot') %>