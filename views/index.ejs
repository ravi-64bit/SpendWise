<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/feather-icons@4.28.0/dist/feather.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Header -->
    <header class="cosmic-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand cosmic-brand" href="#">
                    <i data-feather="zap" class="brand-icon"></i>
                    Cosmic UPI Tracker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link active" href="#dashboard" data-section="dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#add-expense" data-section="add-expense">Add Expense</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#analytics" data-section="analytics">Analytics</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main class="cosmic-main">
        <div class="container">
            <!-- Dashboard Section -->
            <section id="dashboard-section" class="content-section active">
                <div class="section-header">
                    <h1 class="cosmic-title">Expense Dashboard</h1>
                    <div class="d-flex gap-2">
                        <div class="cosmic-search">
                            <input type="text" id="search-expenses" class="form-control" placeholder="Search expenses...">
                            <i data-feather="search"></i>
                        </div>
                        <button class="btn btn--primary" onclick="window.app.showSection('add-expense')">
                            <i data-feather="plus"></i>
                            <span class="d-none d-md-inline ms-1">Add Expense</span>
                        </button>
                    </div>
                </div>

                <!-- Summary Cards -->
                <div class="row cosmic-summary gy-4">
                    <div class="col-md-3 col-6">
                        <div class="card cosmic-card h-100">
                            <div class="card__body">
                                <div class="cosmic-stat">
                                    <div class="stat-icon stat-icon--primary">
                                        <i data-feather="credit-card"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h3 id="total-expenses">₹0</h3>
                                        <p>Total Expenses</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                     <div class="col-md-3 col-6">
                        <div class="card cosmic-card h-100">
                            <div class="card__body">
                                <div class="cosmic-stat">
                                    <div class="stat-icon stat-icon--success">
                                        <i data-feather="check-circle"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h3 id="paid-count">0</h3>
                                        <p>Paid</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                     <div class="col-md-3 col-6">
                        <div class="card cosmic-card h-100">
                            <div class="card__body">
                                <div class="cosmic-stat">
                                    <div class="stat-icon stat-icon--warning">
                                        <i data-feather="clock"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h3 id="pending-count">0</h3>
                                        <p>Pending</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                     <div class="col-md-3 col-6">
                        <div class="card cosmic-card h-100">
                            <div class="card__body">
                                <div class="cosmic-stat">
                                    <div class="stat-icon stat-icon--info">
                                        <i data-feather="list"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h3 id="total-count">0</h3>
                                        <p>Total Transactions</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Expenses -->
                <div class="card cosmic-card mt-4">
                    <div class="card__header">
                        <h4>Recent Expenses</h4>
                    </div>
                    <div class="card__body p-0">
                        <div id="expenses-list" class="cosmic-expenses-list">
                            <!-- Expenses will be populated here -->
                        </div>
                    </div>
                </div>
            </section>

            <!-- Add Expense Section -->
            <section id="add-expense-section" class="content-section" style="display: none;">
                <div class="section-header">
                    <h1 class="cosmic-title">Add New Expense</h1>
                    <button class="btn btn--secondary" onclick="window.app.showSection('dashboard')">
                        <i data-feather="arrow-left"></i>
                        <span class="d-none d-md-inline ms-1">Back to Dashboard</span>
                    </button>
                </div>

                <div class="row">
                    <!-- QR Scanner -->
                    <div class="col-lg-6 mb-4">
                        <div class="card cosmic-card">
                            <div class="card__header d-flex justify-content-between align-items-center">
                                <h5>QR Code Scanner</h5>
                                <button class="btn btn--sm btn--outline" id="toggle-scanner">
                                    <i data-feather="camera"></i>
                                    Start Scanner
                                </button>
                            </div>
                            <div class="card__body">
                                <div id="qr-reader-container" class="qr-scanner-container" style="display: none;">
                                    <div id="qr-reader"></div>
                                </div>
                                <div id="qr-result" class="qr-result" style="display: none;">
                                    <div class="status status--success">
                                        <i data-feather="check"></i>
                                        UPI ID extracted successfully!
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Expense Form -->
                    <div class="col-lg-6 mb-4">
                        <div class="card cosmic-card">
                            <div class="card__header">
                                <h5>Expense Details</h5>
                            </div>
                            <div class="card__body">
                                <form id="expense-form">
                                    <div class="form-group">
                                        <label class="form-label">UPI ID</label>
                                        <input type="text" id="upi-id" class="form-control" placeholder="merchant@bank" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Amount (₹)</label>
                                        <input type="number" id="amount" class="form-control" step="0.01" min="0.01" placeholder="100.00" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Category</label>
                                        <select id="category" class="form-control" required>
                                            <option value="">Select Category</option>
                                            <option value="Food">Food</option>
                                            <option value="Transport">Transport</option>
                                            <option value="Shopping">Shopping</option>
                                            <option value="Bills">Bills</option>
                                            <option value="Entertainment">Entertainment</option>
                                            <option value="Healthcare">Healthcare</option>
                                            <option value="Education">Education</option>
                                            <option value="Others">Others</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Purpose</label>
                                        <input type="text" id="purpose" class="form-control" placeholder="Lunch at restaurant" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Date</label>
                                        <input type="date" id="expense-date" class="form-control" required>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">Notes (Optional)</label>
                                        <textarea id="notes" class="form-control" rows="3" placeholder="Additional notes..."></textarea>
                                    </div>

                                    <div class="cosmic-form-actions">
                                        <button type="submit" class="btn btn--primary btn--full-width">
                                            <i data-feather="plus"></i>
                                            Add Expense
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Analytics Section -->
            <section id="analytics-section" class="content-section" style="display: none;">
                <div class="section-header">
                    <h1 class="cosmic-title">Analytics</h1>
                     <button class="btn btn--secondary" onclick="window.app.showSection('dashboard')">
                        <i data-feather="arrow-left"></i>
                        <span class="d-none d-md-inline ms-1">Back to Dashboard</span>
                    </button>
                </div>

                <div class="row">
                    <div class="col-lg-6 mb-4">
                        <div class="card cosmic-card">
                            <div class="card__header">
                                <h5>Expenses by Category</h5>
                            </div>
                            <div class="card__body">
                                <div class="chart-container" style="position: relative; height: 300px;">
                                    <canvas id="category-chart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 mb-4">
                        <div class="card cosmic-card">
                            <div class="card__header">
                                <h5>Monthly Trend</h5>
                            </div>
                            <div class="card__body">
                                <div class="chart-container" style="position: relative; height: 300px;">
                                    <canvas id="trend-chart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card cosmic-card">
                    <div class="card__header">
                        <h5>Category Breakdown</h5>
                    </div>
                    <div class="card__body">
                        <div id="category-breakdown" class="cosmic-breakdown">
                            <!-- Category breakdown will be populated here -->
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- UPI Payment Modal -->
    <div class="modal fade" id="payment-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cosmic-modal">
                <div class="modal-header">
                    <h5 class="modal-title">UPI Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="payment-details">
                        <div class="payment-info">
                            <h6>Payment Details</h6>
                            <p><strong>UPI ID:</strong> <span id="payment-upi"></span></p>
                            <p><strong>Amount:</strong> ₹<span id="payment-amount"></span></p>
                            <p><strong>Purpose:</strong> <span id="payment-purpose"></span></p>
                        </div>
                        <div class="payment-apps">
                            <h6>Choose Payment App</h6>
                            <div class="app-buttons">
                                <button class="btn btn--outline payment-app-btn" data-app="gpay">
                                    Google Pay
                                </button>
                                <button class="btn btn--outline payment-app-btn" data-app="phonepe">
                                    PhonePe
                                </button>
                                <button class="btn btn--outline payment-app-btn" data-app="paytm">
                                    Paytm
                                </button>
                                <button class="btn btn--outline payment-app-btn" data-app="bhim">
                                    BHIM
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn--secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn--primary" id="generic-pay-btn">
                        <i data-feather="external-link"></i>
                        Pay Now
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Expense Modal -->
    <div class="modal fade" id="edit-modal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cosmic-modal">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Expense</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="edit-expense-form">
                        <input type="hidden" id="edit-expense-id">
                        
                        <div class="form-group">
                            <label class="form-label">UPI ID</label>
                            <input type="text" id="edit-upi-id" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Amount (₹)</label>
                            <input type="number" id="edit-amount" class="form-control" step="0.01" min="0.01" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Category</label>
                            <select id="edit-category" class="form-control" required>
                                <option value="">Select Category</option>
                                <option value="Food">Food</option>
                                <option value="Transport">Transport</option>
                                <option value="Shopping">Shopping</option>
                                <option value="Bills">Bills</option>
                                <option value="Entertainment">Entertainment</option>
                                <option value="Healthcare">Healthcare</option>
                                <option value="Education">Education</option>
                                <option value="Others">Others</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Purpose</label>
                            <input type="text" id="edit-purpose" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Date</label>
                            <input type="date" id="edit-expense-date" class="form-control" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Notes (Optional)</label>
                            <textarea id="edit-notes" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Status</label>
                            <select id="edit-status" class="form-control" required>
                                <option value="pending">Pending</option>
                                <option value="paid">Paid</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn--secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn--primary" id="save-edit-btn">
                        <i data-feather="save"></i>
                        Save Changes
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/app.js"></script>
    <script>
        // Initialize Feather Icons
        feather.replace();
    </script>
</body>
</html>
