    <dt>Date</dt><dd><%= new Date().toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %></dd>
    <dt>General Account Balance</dt><dd><%= generalAccountBalance.toLocaleString('en-IN') %></dd>
    <dt>Personal Account Balance</dt><dd><%= personalAccountBalance.toLocaleString('en-IN') %></dd>
