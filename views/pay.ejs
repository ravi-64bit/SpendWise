<%- include('partials/head') %>
    <form action="/pay" method="POST">
        <label for="upiId" class="field-label">Upi ID:</label>
        <input type="text" id="upiId" name="upiId" class="field-input" value="<%=upiId%>" placeholder="Enter UPI ID" required>

        <label for="billAmount" class="field-label">Amount:</label>
        <input type="number" id="billAmount" name="amount" class="field-input" min="0" step="0.01" value="<%=amount%>" required autofocus>

        <label for="note" class="field-label">Note:</label>
        <input id="note" type="text" maxlength="80" name="note" class="field-input">

        <label for="account" class="field-label">Select Account:</label>
        <select id="account" name="account" class="field-select" required>
            <option value="0">general</option>
            <option value="1">personal</option>
        </select>

        <button type="submit" class="btn">Submit</button>
    </form>
    <a href="/payCash" class="link">Paid in Cash? Enter here.</a>


<%- include('partials/foot') %>